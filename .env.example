# GEMINI_API_KEY: Required for Gemini AI API calls (AI Multilingual Support Chatbot).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The production domain where HimRudra is hosted.
APP_URL="https://himrudra.com"

# SESSION_SECRET: Secret used to sign HTTP-only customer and admin session cookies.
SESSION_SECRET="change-me-in-production"

# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET & RAZORPAY_WEBHOOK_SECRET: Live Razorpay gateway credentials.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ADMIN_EMAIL & ADMIN_PASSWORD: Exclusive store owner account for the private Admin Console.
ADMIN_EMAIL="himrudraofficial@gmail.com"
ADMIN_PASSWORD=""

# Optional Firebase Web Config overrides (for custom domains like Vercel where you manage your own Firebase project)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Optional Resend API credentials for automatic server-side customer inquiry email replies
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HimRudra Support <onboarding@resend.dev>"

# Storage engine selector: "auto" (uses PostgreSQL / Cloud SQL when configured) or "local-json"
STORAGE_ENGINE="auto"

# PostgreSQL Database for Vercel (auto-injected by Vercel Storage -> Neon / Supabase Postgres)
DATABASE_URL=""
# Or individual PostgreSQL fields (used automatically by AI Studio Cloud SQL)
SQL_HOST=""
SQL_PORT=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_SSL=""

# AWS DynamoDB Database (Permanent cloud persistence with atomic TransactWrite stock guards)
# Create a DynamoDB table with Partition key: pk (String), Billing mode: On-Demand, PITR enabled.
AWS_REGION="ap-south-1"
AWS_DYNAMODB_TABLE=""
# Option A (Preferred on AWS / Vercel OIDC): IAM Role ARN (no static secret keys)
AWS_ROLE_ARN=""
# Option B (Scoped IAM User on Vercel): Least-privilege DynamoDB + S3 keys (server-side only, NEVER VITE_*)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# AWS S3 Media Storage (Product photos & Lab Certificate PDFs — keeps DynamoDB items fast and under 400 KB)
AWS_S3_BUCKET=""
AWS_S3_REGION="ap-south-1"
AWS_S3_KEY_PREFIX="himrudra"
# Optional CloudFront / custom CDN base URL (e.g., https://cdn.himrudra.com)
AWS_S3_PUBLIC_BASE_URL=""
